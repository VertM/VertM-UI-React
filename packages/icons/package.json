{
  "name": "@vertm/icons",
  "version": "0.2.0",
  "description": "Direction-aware SVG icon components for VertM UI",
  "license": "MIT",
  "author": "dorren002",
  "homepage": "https://github.com/VertM/VertM-UI-React/tree/main/packages/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VertM/VertM-UI-React.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/VertM/VertM-UI-React/issues"
  },
  "keywords": [
    "vertm",
    "icons",
    "svg",
    "mongolian",
    "vertical-text"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "import": "./dist/definitions.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "typescript": "^5.4.5"
  }
}
