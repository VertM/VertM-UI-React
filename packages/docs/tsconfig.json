{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@vertm/react": ["../react/src/index.ts"],
      "@vertm/core": ["../core/src/index.ts"],
      "@vertm/tokens": ["../tokens/src/index.ts"],
      "@vertm/icons": ["../icons/src/index.ts"],
