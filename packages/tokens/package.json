{
  "name": "@vertm/tokens",
  "version": "0.1.0",
  "description": "Design tokens for VertM UI — colors, spacing, typography, and vertical-layout tokens",
  "license": "MIT",
  "author": "dorren002",
  "homepage": "https://github.com/VertM/VertM-UI-React/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VertM/VertM-UI-React.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/VertM/VertM-UI-React/issues"
  },
  "keywords": [
    "vertm",
    "design-tokens",
    "mongolian",
    "vertical-text",
    "theme"
  ],
  "type": "module",
  "main": "./dist/index.js",
