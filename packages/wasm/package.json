{
  "name": "@vertm/wasm",
  "version": "0.1.0",
  "description": "Optional Harfbuzz WASM shaping for Canvas export and legacy browser fallback",
  "license": "MIT",
  "author": "dorren002",
  "homepage": "https://github.com/VertM/VertM-UI-React/tree/main/packages/wasm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VertM/VertM-UI-React.git",
    "directory": "packages/wasm"
  },
  "bugs": {
    "url": "https://github.com/VertM/VertM-UI-React/issues"
  },
  "keywords": [
    "mongolian",
    "harfbuzz",
    "wasm",
    "text-shaping"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "harfbuzzjs": "^0.4.4"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
